# =================================================================
# SecondBrain Environment Configuration
# =================================================================

# --- Sponsor track: Google Gemini (the ONLY LLM provider) ---
# Obtain your key at https://aistudio.google.com/
GEMINI_API_KEY=

# Recommended models from `python scripts/list_models.py`:
# - LLM_MODEL=gemini-2.5-flash (Fast, cost-effective structured output for extraction & grilling)
# - LLM_MODEL_VISION=gemini-2.5-flash (Multimodal support for image-heavy slide decks)
# - LLM_FALLBACK_MODEL=gemini-1.5-flash (Resilient fallback when primary model throttles)
LLM_MODEL=gemini-3.5-flash
LLM_MODEL_VISION=gemini-3.5-flash
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite

# --- Search ---
# Obtain your key at https://tavily.com/
TAVILY_API_KEY=

# --- Sponsor track: Yugabyte Meko (agent memory over MCP) ---
# Portal: https://cloud.mekodata.ai
MEKO_MODE=live
MEKO_API_KEY=
MEKO_DATAPACK_ID=
MEKO_MCP_URL=
MEKO_CALL_BUDGET=200
MEKO_TIMEOUT_S=8

# --- Operating Flags ---
MOCK=1
DEMO_MODE=
ENABLE_CROSSTALK=1
NEXT_PUBLIC_API_URL=http://localhost:8000
